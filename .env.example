# Public URL of the site (used for canonical links, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://west-mebli.com.ua

# Contact form email delivery via Resend (https://resend.com).
# Without RESEND_API_KEY the form logs submissions to the server console in development
# and reports an error in production.
RESEND_API_KEY=
# Where contact-form messages are delivered (comma-separated for several addresses)
CONTACT_TO_EMAIL=contact@west-mebli.com.ua
# Sender address; its domain must be verified in Resend
CONTACT_FROM_EMAIL=WEST-MEBLI <noreply@west-mebli.com.ua>
